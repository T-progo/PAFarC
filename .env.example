# Copy to .env and fill in real values. Never commit .env.

# SQLAlchemy database URL (SQLite file path relative to the working directory).
PHARMATECH_DATABASE_URL=sqlite:///./pharmatech.db

# Required. At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PHARMATECH_SECRET_KEY=

# Bearer token lifetime in minutes.
PHARMATECH_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Required. Fernet key for encrypting patient data at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing or changing this key makes stored patient data unreadable.
PHARMATECH_DATA_ENCRYPTION_KEY=

# Required. At least 32 characters. Keys the search indexes for CPF and name.
# Generate like PHARMATECH_SECRET_KEY. Changing it breaks search on existing data.
PHARMATECH_BLIND_INDEX_KEY=

# Establishment identification printed on documents (optional; empty values are omitted).
# PHARMATECH_ESTABLISHMENT_NAME defaults to "Programa de Aperfeiçoamento em Farmácia Clínica - PAFarC".
PHARMATECH_ESTABLISHMENT_ADDRESS=
PHARMATECH_ESTABLISHMENT_CNPJ=
PHARMATECH_ESTABLISHMENT_PHONE=
# City/location for the "Cidade - UF, data" line on documents.
PHARMATECH_ESTABLISHMENT_CITY=

# Used by the Streamlit UI only: where the FastAPI backend is running.
PHARMATECH_API_URL=http://127.0.0.1:8000
