# PharmaTech configuration. Copy to .env and fill in real values. Never commit .env.
# The FastAPI backend reads this file; the Streamlit UI only needs PHARMATECH_API_URL.

# --- Database ------------------------------------------------------------------
# SQLAlchemy URL of the SQLite file. In production use an ABSOLUTE path on
# persistent storage (four slashes = absolute), e.g.:
#   PHARMATECH_DATABASE_URL=sqlite:////var/lib/pharmatech/pharmatech.db
PHARMATECH_DATABASE_URL=sqlite:///./pharmatech.db

# --- Secrets (required) ----------------------------------------------------------
# Token signing secret, at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PHARMATECH_SECRET_KEY=

# Fernet key that encrypts patient and clinical data at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NEVER change or lose it once the database has data: the data becomes unreadable.
PHARMATECH_DATA_ENCRYPTION_KEY=

# Key for the CPF/name search indexes, at least 32 characters (generate like the
# secret key). NEVER change it once the database has data: search and duplicate-CPF
# detection would break. The API refuses to start if either key does not match the data.
PHARMATECH_BLIND_INDEX_KEY=

# --- Sessions --------------------------------------------------------------------
# Login lifetime in minutes (default 60). The token is kept only in the Streamlit
# server's memory, never in the browser. When it expires the user is logged out and
# unsaved text is lost, so a work-shift length (e.g. 480) is a reasonable choice.
PHARMATECH_ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Establishment identification on documents (optional) -------------------------
# The name defaults to "Programa de Aperfeiçoamento em Farmácia Clínica - PAFarC".
# PHARMATECH_ESTABLISHMENT_NAME=
# Empty values are simply left out of the PDFs.
PHARMATECH_ESTABLISHMENT_ADDRESS=
PHARMATECH_ESTABLISHMENT_CNPJ=
PHARMATECH_ESTABLISHMENT_PHONE=
# City/location for the "Cidade - UF, data" line on documents.
PHARMATECH_ESTABLISHMENT_CITY=

# --- Streamlit UI ------------------------------------------------------------------
# Where the UI reaches the backend. Set this in the UI process environment.
PHARMATECH_API_URL=http://127.0.0.1:8000
