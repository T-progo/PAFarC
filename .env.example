# Copy to .env and fill in real values. Never commit .env.

# SQLAlchemy database URL (SQLite file path relative to the working directory).
PHARMATECH_DATABASE_URL=sqlite:///./pharmatech.db

# Required. At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PHARMATECH_SECRET_KEY=

# Bearer token lifetime in minutes.
PHARMATECH_ACCESS_TOKEN_EXPIRE_MINUTES=60
